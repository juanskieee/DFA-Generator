{
  "ConnectionStrings": {
    // Mirrors My.Settings.DBConnection
    "DBConnection": "Server=YOUR_SERVER;Database=eMaintenanceSystemDB;Integrated Security=True;TrustServerCertificate=True;"
  },

  "AppVersion": "1.0.0",

  // Mirrors My.Settings.PathServer / PathUserName / PathPassword
  // Not needed for web (no UNC impersonation) — kept for reference only
  "NetworkShare": {
    "Server":   "YOUR_SERVER",
    "UserName": "YOUR_DOMAIN_USER",
    "Password": "YOUR_PASSWORD"
  },

  // Mirrors: "\\PathServer\eMaintenanceSystem\Templates\"
  // In the web app these folders live under ContentRoot
  "EvidenceMaking": {
    "ImagesRoot":    "Uploads\\EvidenceImages",
    "TemplatesRoot": "Templates\\EvidenceMaking",
    "OutputRoot":    "TempData\\GeneratedPdf"
  },

  "Logging": {
    "LogLevel": {
      "Default":                        "Information",
      "Microsoft.AspNetCore":           "Warning"
    }
  },

  "AllowedHosts": "*"
}
