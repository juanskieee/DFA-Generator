<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MachineKarte.Web</RootNamespace>
    <AssemblyName>MachineKarte.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ClosedXML  — replaces GemBox.Spreadsheet for Excel template population
      MIT license, no per-machine activation needed
    -->
    <PackageReference Include="ClosedXML" Version="0.102.2" />

    <!--
      System.Data.SqlClient — plain ADO.NET SQL Server access
      (same as original VB.NET SqlClient, no ORM)
    -->
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />

    <!--
      Optional: SixLabors.ImageSharp if image processing/resizing is needed
      before embedding into Excel
    -->
    <!-- <PackageReference Include="SixLabors.ImageSharp" Version="3.*" /> -->
  </ItemGroup>

  <!--
    Embed template xlsx files as content (copied to output dir)
    so they are available at runtime via ContentRootPath
  -->
  <ItemGroup>
    <Content Include="Templates\EvidenceMaking\*.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Uploads\EvidenceImages\noimage.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
